        <script>
  document.addEventListener("DOMContentLoaded", () => {
    // Crear contenedor principal del skip link
    const skipContainer = document.createElement("div");
    skipContainer.className = "skip-container";

    const innerContainer = document.createElement("div");
    innerContainer.className = "container";

    // Crear enlace
    const skipLink = document.createElement("a");
    skipLink.textContent = "Saltar al contenido";
    skipLink.className = "skip-link";

    let targetId;

    if (document.body.classList.contains("dPrincipal")) {
      // Página principal: asignar id dinámico
      const homeEl = document.querySelector(".content-home");
      if (homeEl) homeEl.id = "content-home";
      targetId = "content-home";
    } else {
      // Internas: ya existe main-content, no tocar
      targetId = "main-content";
    }

    skipLink.href = "#" + targetId;

    // Al hacer click/Enter, mover foco al destino
    skipLink.addEventListener("click", (e) => {
      e.preventDefault();
      const target = document.getElementById(targetId);
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.focus();
      }
    });

    // Insertar estructura al inicio del body
    innerContainer.appendChild(skipLink);
    skipContainer.appendChild(innerContainer);
    document.body.insertBefore(skipContainer, document.body.firstChild);
  });
</script>

<style>
  .skip-container {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 99999;
    width: 100%;
  }
  .skip-link {
    color: #fff !important;
    text-decoration: none !important;
    padding: 0.5rem 1rem;
    display: inline-block;
    position: absolute;
    left: -999px;
  }
  .skip-link:focus {
    position: static;
    margin: 0.5rem 0;
    outline: 2px solid #fff !important;
    background-color: #3366cc;
  }
</style>
