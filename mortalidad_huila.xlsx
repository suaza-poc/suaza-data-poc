<script type="text/javascript">
jQuery(function($) {
	function nxFixAccordionLinks(scope) {
		$(scope).find('.typeAccordion a.section').each(function() {
			var $link = $(this);
			var href = $link.attr('href');

			// Si tiene href y NO es "#", debe comportarse como enlace directo
			if (href && href !== '#') {
				// Quitar handlers del acordeón (namespaced) y genéricos por si acaso
				$link.off('.accordion').off('click keydown');

				// Clonar sin eventos y reemplazar para asegurar que no queden handlers
				var $clean = $link.clone(false, false);

				// Quitar clases de jQuery UI / acordeón
				$clean.removeClass('ui-accordion-header ui-state-default ui-accordion-icons ui-accordion-header-collapsed ui-corner-all ui-corner-top ui-state-active ui-state-hover');

				// Eliminar atributos ARIA y otros del acordeón
				$clean.removeAttr('role')
					.removeAttr('aria-controls')
					.removeAttr('aria-selected')
					.removeAttr('aria-expanded')
					.removeAttr('aria-disabled')
					.removeAttr('id')
					.removeAttr('tabindex');

				// Eliminar el ícono dentro del <a>
				$clean.find('span.ui-accordion-header-icon, span.ui-icon').remove();

				// Añadir clase propia para estilos
				$clean.addClass("nx-accordion-link");

				// Evitar que el contenedor/accordion intercepte el click
				$clean.on('click', function(e) {
					e.stopPropagation(); // deja pasar la navegación normal del <a>
				});

				$link.replaceWith($clean);
			}
		});
	}

	// Ejecutar al cargar el DOM
	nxFixAccordionLinks(document);

	// Reintento breve por si el acordeón se inicializa después
	setTimeout(function() {
		nxFixAccordionLinks(document);
	}, 200);

	// Por si recursos externos inicializan el acordeón en window.load
	$(window).on('load', function() {
		nxFixAccordionLinks(document);
	});
});
</script>

