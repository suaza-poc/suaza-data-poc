# 7. Guardar outputs
# ----------------------------------------------------------
write_csv(
mortalidad,
csv_file,
na = ""
)
write_parquet(
mortalidad,
parquet_file
)
# ----------------------------------------------------------
# 8. Mensajes
# ----------------------------------------------------------
message(
glue(
"✅ Mortalidad por suicidio procesada: ",
"{nrow(mortalidad)} registros."
)
)
message(
glue(
"💾 CSV: {csv_file}"
)
)
message(
glue(
"💾 Parquet: {parquet_file}"
)
)
# ----------------------------------------------------------
# 9. Retorno
# ----------------------------------------------------------
