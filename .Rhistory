transmute(
iso3 = "COL",
territorio = as.character(Territorio),
cod_subnacional = as.character(Regional),
cod_local = as.character(`Cod - Terr`),
anio = as.integer(Año),
valor = as.numeric(Suicidios) /
as.numeric(Población) * 100000,
sexo = as.character(Sexo)
) |>
filter(
!is.na(anio),
!is.na(valor)
) |>
arrange(
territorio,
anio,
sexo
)
# ----------------------------------------------------------
# 5. Crear directorios de salida
# ----------------------------------------------------------
dir_create(
file.path(output_dir, "csv")
)
dir_create(
file.path(output_dir, "parquet")
)
# ----------------------------------------------------------
# 6. Definir archivos de salida
# ----------------------------------------------------------
csv_file <- file.path(
output_dir,
"csv",
"mortalidad-suicidio.csv"
)
parquet_file <- file.path(
output_dir,
"parquet",
"mortalidad-suicidio.parquet"
)
# ----------------------------------------------------------
# 7. Guardar CSV y Parquet
# ----------------------------------------------------------
write_csv(
suicidio,
csv_file,
na = ""
)
write_parquet(
suicidio,
parquet_file
)
# ----------------------------------------------------------
# 8. Mensajes
# ----------------------------------------------------------
message(
glue(
"✅ Mortalidad por suicidio procesada: ",
"{nrow(suicidio)} registros."
)
)
message(
glue(
"💾 CSV: {csv_file}"
)
)
message(
glue(
"💾 Parquet: {parquet_file}"
)
)
# ----------------------------------------------------------
# 9. Retorno
# ----------------------------------------------------------
return(
list(
data = suicidio,
output_files = c(
csv_file,
parquet_file
)
)
)
}
result <- process_mortalidad_suicidio()
